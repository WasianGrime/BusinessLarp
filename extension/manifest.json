{
  "manifest_version": 3,
  "name": "BusinessLarp Terminal",
  "short_name": "BusinessLarp",
  "version": "0.0.0",
  "description": "A completely real, extremely serious day trading terminal. Fake companies, fake money, real vibes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open BusinessLarp Terminal",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Open BusinessLarp Terminal"
    }
  }
}
